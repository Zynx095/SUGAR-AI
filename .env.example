# Copy to .env and fill in what you use. Never commit .env.

# FreeLLMAPI (default conversational provider, local desktop app on 127.0.0.1:31415)
FREELLMAPI_API_KEY=

# Optional: Claude through the API. Without it, Sugar uses the installed Claude CLI
# (your Claude subscription) for deep-reasoning requests.
ANTHROPIC_API_KEY=

# Optional: Spotify Web API (playback control, "play <song>")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Any setting can be overridden with SUGAR__SECTION__KEY, e.g.
# SUGAR__TTS__SPEED=1.2
# SUGAR__CONVERSATION__ENGAGEMENT=always
# SUGAR__UI__WINDOW=edge
